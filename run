#!/usr/bin/env sh

podman build build-context \
       --file Containerfile.relaxedstacked \
       --tag intraj-nonincremental

mkdir -p results/

podman run \
       --rm \
       --volume "$PWD/results":/root/results \
       --volume "$PWD/run-benchmark":/root/run-benchmark \
       localhost/intraj-nonincremental:latest \
       ./run-benchmark results/incremental.log

podman run \
       --rm \
       --volume "$PWD/results":/root/results \
       --volume "$PWD/run-benchmark":/root/run-benchmark \
       localhost/intraj-incremental:latest \
       ./run-benchmark results/nonincremental.log
